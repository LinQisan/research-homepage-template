# Optional local deployment configuration. Copy to .env.deploy and fill later.
# GitHub Actions reads repository Secrets, not this file.
# Quote values with single quotes; escape a literal single quote as '\''.
FTPS_HOST=''
FTPS_USERNAME=''
FTPS_PASSWORD=''
FTPS_REMOTE_DIR=''

# Explicit FTPS (FTP over TLS), normally port 21. Blank uses 21.
FTPS_PORT=''
